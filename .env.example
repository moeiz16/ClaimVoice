# ClaimVoice settings. Copy to .env (make setup does this). Everything works offline with these defaults:
# no accounts, no keys, fakes for speech, language understanding and text messages.

ENVIRONMENT=development
# Change for anything but a local demo (32+ characters).
SECRET_KEY=dev-only-change-me-claimvoice-0000000000000000
WEB_ORIGIN=http://localhost:3040
API_PORT=8040
# SQLite by default (data/claimvoice.db). Postgres: postgresql+asyncpg://user:pass@host/claimvoice (pip install ".[postgres]")
# DATABASE_URL=sqlite+aiosqlite:///./data/claimvoice.db

# Demo clock: business "today" for the API, voice line, seed and screenshots. "off" = real time.
CLAIMVOICE_DEMO_TODAY=2026-01-08
# Pin the time of day too (shared by all processes through data/demo-clock.json): 7:42 a.m. Calgary time.
CLAIMVOICE_DEMO_TIME=07:42
CLAIMVOICE_DEMO_TZ=America/Edmonton

# Sessions use the real clock.
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
COOKIE_SECURE=false

# Language understanding: deterministic fake by default. For a cloud model through LiteLLM:
#   make setup-ai, set LLM_FAKE=false, pick LLM_MODEL and set the matching free-tier key below.
#   LLM_MODEL uses LiteLLM's provider/model names (groq/..., gemini/..., openrouter/...).
#   On a timeout (600 ms), an error or an invalid answer the offline rules answer that turn instead.
LLM_FAKE=true
LLM_MODEL=groq/llama-3.1-8b-instant
# GROQ_API_KEY is also used by STT_PROVIDER=groq (Whisper).
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Speech for "voice" mode: "fake" by default (the browser demo recognises and speaks speech itself).
# Cloud adapters need no extra install; set a provider and its key (no key = the fake is used).
#   STT_PROVIDER: fake | groq (Whisper, uses GROQ_API_KEY) | deepgram
#   TTS_PROVIDER: fake | cartesia | elevenlabs
STT_PROVIDER=fake
TTS_PROVIDER=fake
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
# Voice ids per language for Cartesia and ElevenLabs:
# CARTESIA_VOICE_EN=
# CARTESIA_VOICE_FR=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_FR=

# Text messages (photo links): fake outbox only; nothing is ever sent. No SMS provider is wired in.
SMS_PROVIDER=fake
# Weather and catastrophe alerts: the bundled snapshot (backend/claimvoice/tools/data/weather_snapshot.json).
WEATHER_SOURCE=bundled

# Voice runtime: STUN/TURN servers, comma-separated (empty = local host candidates, fine on one machine).
VOICE_ICE_SERVERS=
VOICE_TURN_BUDGET_MS=800
VOICE_TOOL_BUDGET_MS=600

# Model tracking (local SQLite + mlruns/, git-ignored).
# MLFLOW_TRACKING_URI=sqlite:///./mlruns/mlflow.db

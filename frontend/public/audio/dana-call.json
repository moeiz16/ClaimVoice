{
 "claimNumber": "CV-26-01842",
 "language": "en",
 "durationSeconds": 79.07,
 "sample": "Sample call, voices are synthetic",
 "turns": [
  {
   "who": "cv",
   "from": 0.0,
   "to": 7.44,
   "text": "Larkspur Mutual claims, this is ClaimVoice, an automated assistant. This call is recorded so we get your claim right. Is that okay?",
   "spans": []
  },
  {
   "who": "caller",
   "from": 7.89,
   "to": 9.12,
   "text": "Yes, that's fine.",
   "spans": [
    {
     "text": "Yes, that's fine.",
     "key": "consent"
    }
   ]
  },
  {
   "who": "cv",
   "from": 9.52,
   "to": 13.32,
   "text": "Thank you. What's your policy number, or the phone number on your policy?",
   "spans": []
  },
  {
   "who": "caller",
   "from": 13.77,
   "to": 17.11,
   "text": "It's L-M, A-B, one-eight-seven, three-four-two.",
   "spans": [
    {
     "text": "L-M, A-B, one-eight-seven, three-four-two",
     "key": "policy"
    }
   ]
  },
  {
   "who": "cv",
   "from": 17.51,
   "to": 21.45,
   "text": "Found it, Dana. Before anything else: is everyone safe right now?",
   "spans": []
  },
  {
   "who": "caller",
   "from": 21.9,
   "to": 26.13,
   "text": "Yes, we're fine. The wind just smashed the skylight over the kitchen.",
   "spans": [
    {
     "text": "we're fine",
     "key": "hurt"
    },
    {
     "text": "smashed the skylight over the kitchen",
     "key": "skylight"
    }
   ]
  },
  {
   "who": "cv",
   "from": 26.53,
   "to": 30.65,
   "text": "I'm sorry, that sounds frightening. When did it happen, and do you know what hit it?",
   "spans": []
  },
  {
   "who": "caller",
   "from": 31.1,
   "to": 35.46,
   "text": "About ten past two. Something blew off the neighbour's deck and came right through.",
   "spans": [
    {
     "text": "About ten past two",
     "key": "when"
    },
    {
     "text": "blew off the neighbour's deck",
     "key": "debris"
    }
   ]
  },
  {
   "who": "cv",
   "from": 35.86,
   "to": 37.52,
   "text": "Is anything still open to the weather?",
   "spans": []
  },
  {
   "who": "caller",
   "from": 37.97,
   "to": 44.81,
   "text": "No, I've taped a garbage bag over it. Do you need my card for the deductible? It's [card number removed]",
   "spans": [
    {
     "text": "taped a garbage bag over it",
     "key": "covered"
    }
   ],
   "hush": 43.51
  },
  {
   "who": "cv",
   "from": 45.21,
   "to": 50.21,
   "text": "Please stop there. I never take card numbers on this line, and that part of the recording is removed.",
   "spans": [
    {
     "text": "I never take card numbers",
     "key": "card"
    }
   ]
  },
  {
   "who": "caller",
   "from": 50.66,
   "to": 52.3,
   "text": "Oh. Okay, good.",
   "spans": []
  },
  {
   "who": "cv",
   "from": 52.7,
   "to": 56.83,
   "text": "I'm texting you a link for photos of the skylight. Take them when it's light and safe.",
   "spans": [
    {
     "text": "texting you a link for photos",
     "key": "photos"
    }
   ]
  },
  {
   "who": "caller",
   "from": 57.28,
   "to": 57.71,
   "text": "Got it.",
   "spans": []
  },
  {
   "who": "cv",
   "from": 58.11,
   "to": 69.05,
   "text": "Here's what I have: wind damage at 1418 Elbow Drive Southwest around ten past two, the kitchen skylight broken by debris from the neighbour's deck, now covered, and nobody hurt. Is that right?",
   "spans": [
    {
     "text": "Here's what I have",
     "key": "readback"
    }
   ]
  },
  {
   "who": "caller",
   "from": 69.5,
   "to": 70.13,
   "text": "That's right.",
   "spans": []
  },
  {
   "who": "cv",
   "from": 70.53,
   "to": 79.07,
   "text": "Your claim number is CV-26-01842. Because of the storm, an adjuster will call you within two business days. Call back any time.",
   "spans": [
    {
     "text": "CV-26-01842",
     "key": "claimno"
    }
   ]
  }
